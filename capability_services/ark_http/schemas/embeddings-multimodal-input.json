    },
    "dimensions": {
      "type": "integer"
    },
    "encoding_format": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "multi_embedding": {
      "type": "object",
      "properties": {}
    },
    "sparse_embedding": {
      "type": "object",
      "properties": {}
    }
  },
  "required": [
    "model",
    "input"
  ],
  "additionalProperties": false
}
