{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "const": "videos_list"
    },
    "result": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "status": {
                "type": "string",
                "enum": [
                  "queued",
                  "running",
                  "cancelled",
                  "succeeded",
                  "failed",
                  "expired"
                ]
              }
            },
            "required": [
              "id",
              "status"
            ]
          }
        },
        "total": {
          "type": "integer",
          "description": "Matching provider video tasks (count)."
        }
      },
      "required": [
        "items"
      ],
      "description": "Native video task fields retain provider units: created_at/updated_at are Unix seconds, duration is seconds, frames is a frame count, framespersecond is frames per second (fps), and execution_expires_after is a relative interval in seconds."
    }
  },
  "required": [
    "action",
    "result"
  ]
}
