{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "const": "videos_get"
    },
    "result": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "cancelled",
            "succeeded",
            "failed",
            "expired"
          ]
        },
        "content": {
          "type": "object",
          "properties": {
            "video_url": {
              "type": "string"
            },
            "last_frame_url": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "status"
      ],
      "description": "Native video task fields retain provider units: created_at/updated_at are Unix seconds, duration is seconds, frames is a frame count, framespersecond is frames per second (fps), and execution_expires_after is a relative interval in seconds."
    }
  },
  "required": [
    "action",
    "result"
  ]
}
