{
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 3600
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "overwrite": {
      "type": "boolean"
    }
  },
  "required": [
    "path",
    "size",
    "sha256"
  ],
  "additionalProperties": false
}
