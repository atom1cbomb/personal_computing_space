{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "const": "grades_analyze"
    },
    "result": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean",
          "const": true,
          "description": "All pages of the selected recorded-grade scope were collected. Does not establish roster coverage or a transactional snapshot."
        },
        "collected_at": {
          "type": "string",
          "description": "Collection completion in RFC3339 UTC, including timezone."
        },
        "source_record_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of records or students (count)."
        },
        "selected_record_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of records or students (count)."
        },
        "selection": {
          "type": "string",
          "const": "latest_per_student_paper",
          "description": "Upstream latest=true followed by one record per (paper_id, user_id), ordered by (time, status_id)."
        },
        "filters": {
          "type": "object",
          "properties": {
            "paper_id": {
              "type": "integer",
              "minimum": 1,
              "description": "Opaque positive upstream identifier; not a count or student name."
            },
            "category": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            },
            "group": {
              "type": "string",
              "maxLength": 256,
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "paper_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Opaque positive upstream identifier; not a count or student name."
        },
        "summary": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of records or students (count)."
            },
            "min": {
              "type": [
                "number",
                "null"
              ],
              "description": "Original score points; null when no recorded grades exist."
            },
            "max": {
              "type": [
                "number",
                "null"
              ],
              "description": "Original score points; null when no recorded grades exist."
            },
            "mean": {
              "type": [
                "number",
                "null"
              ],
              "description": "Original score points; null when no recorded grades exist."
            },
            "median": {
              "type": [
                "number",
                "null"
              ],
              "description": "Original score points; null when no recorded grades exist."
            },
            "stddev": {
              "type": [
                "number",
                "null"
              ],
              "description": "Population standard deviation in original points (ddof=0); null for no records and zero for a singleton."
            },
            "pass_score": {
              "type": [
                "number",
                "null"
              ],
              "description": "Caller-supplied inclusive pass threshold in original points, or null when omitted."
            },
            "max_score": {
              "type": [
                "number",
                "null"
              ],
              "description": "Caller-confirmed full score in original points, or null when omitted."
            },
            "pass_count": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Number of students at or above pass_score, or null when no threshold was supplied."
            },
            "pass_rate_percent": {
              "type": [
                "number",
                "null"
              ],
              "description": "Percentage (100 means 100%), not a 0–1 ratio. Null without the required threshold/full score or with no records."
            },
            "mean_percent": {
              "type": [
                "number",
                "null"
              ],
              "description": "mean / caller-confirmed max_score × 100. Not clamped: bonus points may exceed 100%. Null without max_score or records."
            },
            "distribution": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "point": {
                    "type": "integer",
                    "description": "Original point score from PaperStatusDTO.point; zero is an observed score. No assumed maximum or normalization."
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Number of records or students (count)."
                  }
                },
                "required": [
                  "point",
                  "count"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "count",
            "min",
            "max",
            "mean",
            "median",
            "stddev",
            "pass_score",
            "max_score",
            "pass_count",
            "pass_rate_percent",
            "mean_percent",
            "distribution"
          ],
          "additionalProperties": false
        },
        "by_group": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string"
              },
              "summary": {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Number of records or students (count)."
                  },
                  "min": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Original score points; null when no recorded grades exist."
                  },
                  "max": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Original score points; null when no recorded grades exist."
                  },
                  "mean": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Original score points; null when no recorded grades exist."
                  },
                  "median": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Original score points; null when no recorded grades exist."
                  },
                  "stddev": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Population standard deviation in original points (ddof=0); null for no records and zero for a singleton."
                  },
                  "pass_score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Caller-supplied inclusive pass threshold in original points, or null when omitted."
                  },
                  "max_score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Caller-confirmed full score in original points, or null when omitted."
                  },
                  "pass_count": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Number of students at or above pass_score, or null when no threshold was supplied."
                  },
                  "pass_rate_percent": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Percentage (100 means 100%), not a 0–1 ratio. Null without the required threshold/full score or with no records."
                  },
                  "mean_percent": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "mean / caller-confirmed max_score × 100. Not clamped: bonus points may exceed 100%. Null without max_score or records."
                  },
                  "distribution": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "point": {
                          "type": "integer",
                          "description": "Original point score from PaperStatusDTO.point; zero is an observed score. No assumed maximum or normalization."
                        },
                        "count": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Number of records or students (count)."
                        }
                      },
                      "required": [
                        "point",
                        "count"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "count",
                  "min",
                  "max",
                  "mean",
                  "median",
                  "stddev",
                  "pass_score",
                  "max_score",
                  "pass_count",
                  "pass_rate_percent",
                  "mean_percent",
                  "distribution"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "group",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "students_included": {
          "type": "boolean"
        },
        "students": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "paper_id": {
                "type": "integer",
                "minimum": 1,
                "description": "Opaque positive upstream identifier; not a count or student name."
              },
              "title": {
                "type": "string"
              },
              "category": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status_id": {
                "type": "integer",
                "minimum": 1,
                "description": "Opaque positive upstream identifier; not a count or student name."
              },
              "paper_instance_id": {
                "type": "integer",
                "minimum": 1,
                "description": "Opaque positive upstream identifier; not a count or student name."
              },
              "user_id": {
                "type": "integer",
                "minimum": 1,
                "description": "Opaque positive upstream identifier; not a count or student name."
              },
              "user_name": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "point": {
                "type": "integer",
                "description": "Original point score from PaperStatusDTO.point; zero is an observed score. No assumed maximum or normalization."
              },
              "time": {
                "type": "integer",
                "description": "Unconverted upstream PaperStatusDTO.time value. Its unit is unspecified by the OpenAPI; used only to order attempts, breaking ties by status_id."
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "description": "Competition rank by descending point in this paper's selected cohort; ties share rank (1, 1, 3)."
              }
            },
            "required": [
              "paper_id",
              "title",
              "category",
              "status_id",
              "paper_instance_id",
              "user_id",
              "user_name",
              "group",
              "point",
              "time",
              "rank"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "complete",
        "collected_at",
        "source_record_count",
        "selected_record_count",
        "selection",
        "filters",
        "paper_id",
        "summary",
        "by_group",
        "students_included",
        "students"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "action",
    "result"
  ],
  "additionalProperties": false
}
