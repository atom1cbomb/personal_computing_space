+    def _refresh_session(self, session: AuthSession) -> bool:
+        if not session.refresh_token:
+            # A still-valid non-refreshable token can be used until its expiry.
+            if session.expires_at > _utcnow():
+                return True
+            self.auth_session_repo.delete(session.id)
+            return False
+        try:
+            tokens = self.refresh_access_token(session.refresh_token)
+            new_access = tokens["access_token"]
+            new_refresh = tokens.get("refresh_token") or session.refresh_token
+            lifetime = tokens.get("expires_in", 3600)
+            if (not isinstance(new_access, str) or not new_access
+                    or not isinstance(new_refresh, str) or not new_refresh
+                    or isinstance(lifetime, bool) or not isinstance(lifetime, (int, float))
+                    or lifetime <= 0):
+                raise ValueError("Invalid token response")
+            new_expires = _utcnow() + timedelta(seconds=lifetime)
+        except http_requests.HTTPError as exc:
