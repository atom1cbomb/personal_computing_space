diff --git a/tests/test_auth_refresh.py b/tests/test_auth_refresh.py
new file mode 100644
index 0000000..8811c2b
--- /dev/null
+++ b/tests/test_auth_refresh.py
@@ -0,0 +1,149 @@
+from concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor
+from datetime import timedelta
+import json
+import threading
+import time
+
+import pytest
+import requests
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+from autopapers.config import AuthConfig
+from autopapers.models.db import Base, User
+from autopapers.repository.auth_session import AuthSessionRepository
+from autopapers.repository.user import UserRepository
+from autopapers.services.auth import AuthRefreshUnavailable, AuthService, _utcnow
+
+
+@pytest.fixture
+def session_store(tmp_path):
+    engine = create_engine(f"sqlite:///{tmp_path / 'sessions.db'}")
+    Base.metadata.create_all(engine)
+    factory = sessionmaker(bind=engine)
+    with factory() as db:
+        db.add(User(id="user", email="user@example.test", name="User", role="user"))
+        db.commit()
+        AuthSessionRepository(db).create("sid", "user", "old-access", "old-refresh", _utcnow())
+    yield factory
+    engine.dispose()
+
+
+def service(db):
+    return AuthService(AuthConfig(), UserRepository(db), AuthSessionRepository(db))
+
+
+@pytest.mark.parametrize("failure", [requests.Timeout("private provider token"),
+    requests.ConnectionError("private network details"), ValueError("invalid JSON")])
+def test_transient_refresh_failure_recovers_without_new_login(session_store, monkeypatch, failure):
+    with session_store() as db:
+        auth = service(db)
+        monkeypatch.setattr(auth, "refresh_access_token", lambda _: (_ for _ in ()).throw(failure))
+        with pytest.raises(AuthRefreshUnavailable, match="temporarily unavailable") as error:
+            auth.get_valid_session(db, "sid")
+        assert "private" not in str(error.value)
+        saved = auth.auth_session_repo.get("sid")
+        assert saved.access_token == "old-access" and saved.refresh_token == "old-refresh"
+        monkeypatch.setattr(auth, "refresh_access_token", lambda _: {
+            "access_token": "new-access", "refresh_token": "new-refresh", "expires_in": 3600})
+        user, saved = auth.get_valid_session(db, "sid")
+        assert user.id == "user" and saved.refresh_token == "new-refresh"
+    with session_store() as db:
+        auth = service(db)
+        monkeypatch.setattr(auth, "refresh_access_token", lambda _: pytest.fail("valid saved token refreshed"))
+        assert auth.get_valid_session(db, "sid")[1].access_token == "new-access"
+
+
+@pytest.mark.parametrize("status,code,deleted", [(400, "invalid_grant", True),
+    (401, "invalid_grant", True), (400, "invalid_client", False),
+    (429, "invalid_grant", False), (503, "server_error", False)])
+def test_only_explicit_revocation_deletes_session(session_store, monkeypatch, status, code, deleted):
+    response = requests.Response()
+    response.status_code = status
+    response._content = json.dumps({"error": code, "error_description": "private provider detail"}).encode()
+    failure = requests.HTTPError("private response", response=response)
+    with session_store() as db:
+        auth = service(db)
+        monkeypatch.setattr(auth, "refresh_access_token", lambda _: (_ for _ in ()).throw(failure))
+        if deleted:
+            assert auth.get_valid_session(db, "sid") is None
+        else:
+            with pytest.raises(AuthRefreshUnavailable):
+                auth.get_valid_session(db, "sid")
+        assert (auth.auth_session_repo.get("sid") is None) is deleted
+
+
+@pytest.mark.parametrize("result", [{}, {"access_token": "", "expires_in": 3600},
+    {"access_token": "new", "expires_in": -1}, {"access_token": "new", "expires_in": float("inf")},
+    {"access_token": "new", "expires_in": True}])
+def test_invalid_refresh_response_keeps_saved_credentials(session_store, monkeypatch, result):
+    with session_store() as db:
+        auth = service(db)
+        monkeypatch.setattr(auth, "refresh_access_token", lambda _: result)
+        with pytest.raises(AuthRefreshUnavailable):
+            auth.get_valid_session(db, "sid")
+        assert auth.auth_session_repo.get("sid").refresh_token == "old-refresh"
+
+
+def test_omitted_refresh_token_is_preserved(session_store, monkeypatch):
+    with session_store() as db:
+        auth = service(db)
+        monkeypatch.setattr(auth, "refresh_access_token", lambda _: {"access_token": "new", "expires_in": 3600})
+        assert auth.get_valid_session(db, "sid")[1].refresh_token == "old-refresh"
+
+
+def test_nonrefreshable_token_lives_until_its_actual_expiry(session_store):
+    with session_store() as db:
+        auth = service(db)
+        saved = auth.auth_session_repo.get("sid")
+        saved.refresh_token = None
+        saved.expires_at = _utcnow() + timedelta(seconds=60)
+        db.commit()
+        assert auth.get_valid_session(db, "sid") is not None
+        saved.expires_at = _utcnow() - timedelta(seconds=1)
+        db.commit()
+        assert auth.get_valid_session(db, "sid") is None
+
+
+def test_concurrent_requests_spend_rotating_token_once(session_store):
+    barrier = threading.Barrier(6)
+    calls = []
+    def request(_):
+        with session_store() as db:
+            auth = service(db)
+            # Seed the identity map with stale data, as simultaneous requests do.
+            auth.auth_session_repo.get("sid")
+            def refresh(token):
+                calls.append(token)
+                time.sleep(.05)
+                return {"access_token": "new", "refresh_token": "rotated", "expires_in": 3600}
+            auth.refresh_access_token = refresh
+            barrier.wait(timeout=5)
+            return auth.get_valid_session(db, "sid")[1].refresh_token
+    with ThreadPoolExecutor(max_workers=6) as pool:
+        assert list(pool.map(request, range(6))) == ["rotated"] * 6
+    assert calls == ["old-refresh"]
+
+
+def _worker_request(arguments):
+    database_url, marker = arguments
+    engine = create_engine(database_url)
+    with sessionmaker(bind=engine)() as db:
+        auth = service(db)
+        def refresh(token):
+            with open(marker, "x") as stream:
+                stream.write("one refresh")
+            if token != "old-refresh":
+                raise AssertionError("already refreshed")
+            time.sleep(.1)
+            return {"access_token": "new", "refresh_token": "rotated", "expires_in": 3600}
+        auth.refresh_access_token = refresh
+        result = auth.get_valid_session(db, "sid")[1].refresh_token
+    engine.dispose()
+    return result
+
+
+def test_process_workers_reload_tokens_after_lock(session_store, tmp_path):
+    with ProcessPoolExecutor(max_workers=3) as pool:
+        results = list(pool.map(_worker_request, [(str(session_store.kw["bind"].url), str(tmp_path / "refreshed"))] * 3))
+    assert results == ["rotated"] * 3
