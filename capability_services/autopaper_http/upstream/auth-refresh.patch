+            try:
+                error = response.json().get("error") if response is not None else None
+            except (ValueError, AttributeError):
+                error = None
+            if response is not None and response.status_code in {400, 401} and error == "invalid_grant":
+                self.auth_session_repo.delete(session.id)
+                return False
+            raise AuthRefreshUnavailable("Authentication refresh temporarily unavailable") from None
+        except (http_requests.RequestException, ValueError, TypeError, KeyError, OverflowError):
+            raise AuthRefreshUnavailable("Authentication refresh temporarily unavailable") from None
+        self.auth_session_repo.update_tokens(session.id, new_access, new_refresh, new_expires)
+        return True
