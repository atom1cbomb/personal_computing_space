     def get(self, session_id: str) -> AuthSession | None:
         return self.db.get(AuthSession, session_id)
 
+    @contextmanager
+    def refresh_lock(self, session_id: str):
+        """Serialize refresh-token rotation across workers on this host.
+
+        SQLite is the deployed session store. Fixed lock stripes avoid both a
+        global database write lock during network I/O and unbounded lock files.
+        Authentication runs before business writes, so discard the read snapshot
+        and reload after acquiring the lock (another worker may have refreshed).
+        """
+        engine = self.db.get_bind()
+        identity = str(engine.url) if hasattr(engine, "url") else str(engine.engine.url)
+        if identity.startswith("sqlite:"):
+            database = engine.url.database if hasattr(engine, "url") else engine.engine.url.database
+            if database and database != ":memory:":
+                identity = str(Path(database).resolve())
+        digest = hashlib.sha256((identity + "\0" + session_id).encode()).digest()
+        root = Path(tempfile.gettempdir()) / ("autopapers-auth-" + str(os.getuid()))
+        root.mkdir(mode=0o700, exist_ok=True)
+        with FileLock(root / f"{digest[0]:02x}.lock", timeout=20, mode=0o600):
+            self.db.rollback()
+            yield self.get(session_id)
+
