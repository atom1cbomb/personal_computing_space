{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "const": "years_list"
    },
    "result": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "description": "Publication calendar year, for example 2026."
          },
          "count": {
            "type": "integer",
            "minimum": 0,
