{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\\\x00-\\x1f]+$"
    },
    "archive_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52428800
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    }
  },
  "required": [
    "name",
    "archive_size",
    "archive_sha256",
    "idempotency_key"
  ],
  "additionalProperties": false
}
