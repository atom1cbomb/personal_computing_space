{
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "deleted_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "description": "Project-relative source path, limited to 1024 UTF-8 bytes; non-ASCII paths may contain fewer characters."
      },
      "maxItems": 2000
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "archive_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52428800,
      "description": "Exact ZIP archive length in bytes (B), 1–52428800 B (50 MiB). Example: a 1 MiB ZIP uses 1048576. Send this many archive bytes after stream-open."
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    }
  },
  "required": [
    "project_id",
    "base_revision",
    "deleted_paths",
    "message",
    "archive_size",
    "archive_sha256",
    "idempotency_key"
  ],
  "additionalProperties": false
}
