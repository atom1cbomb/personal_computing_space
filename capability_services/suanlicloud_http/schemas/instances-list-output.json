{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "const": "instances_list"
    },
    "result": {
      "type": "object",
      "properties": {
        "Instances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "InstanceId": {
                "type": "string"
              },
              "State": {
                "type": "string"
              },
              "Ip": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Ips": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "InstanceId"
            ],
            "description": "Provider VM object. Cpu is a vCPU count; Mem and DiskSize are bytes (B), as is Disks[].SizeBytes when present. Vmid is an opaque numeric VM identifier; Disks[].BusIndex is a zero-based disk index within its bus."
          }
        },
        "PageNumber": {
          "type": "integer",
          "description": "Current page number, starting at 1."
        },
        "PageSize": {
          "type": "integer",
          "description": "Instances per page (count)."
        },
        "TotalCount": {
          "type": "integer",
          "description": "Total matching instances (count)."
        }
      },
      "required": [
        "Instances"
      ]
    }
  },
  "required": [
    "action",
    "result"
  ]
}
