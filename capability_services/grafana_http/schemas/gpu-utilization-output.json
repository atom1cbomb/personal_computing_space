{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "no_data"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "hostname": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "const": "percent"
    },
    "metric": {
      "type": "string"
    },
    "datasource_uid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "queried_at": {
      "type": "string",
      "description": "Gateway query time as a timezone-qualified RFC3339 timestamp."
    },
    "query_time": {
      "type": "string",
      "description": "Requested sample time as a timezone-qualified RFC3339 timestamp."
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string"
          },
          "gpu_index": {
            "type": "integer",
            "minimum": 0,
            "description": "GPU device index from the verified metric label (nonnegative identifier, not a GPU count)."
          },
          "gpu_uuid": {
            "type": [
              "string",
              "null"
            ]
          },
          "utilization_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "GPU busy utilization in percent, 0–100; 50 means 50%. A ratio input is multiplied by 100."
          },
          "sampled_at": {
            "type": "string",
            "description": "Sample time as a timezone-qualified RFC3339 timestamp."
          },
          "labels": {
            "type": "object",
            "properties": {}
          }
        },
        "required": [
          "hostname",
          "gpu_index",
          "gpu_uuid",
          "utilization_percent",
          "sampled_at",
          "labels"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "infos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "complete",
    "hostname",
    "unit",
    "metric",
    "datasource_uid",
    "queried_at",
    "query_time",
    "samples",
    "warnings",
    "infos"
  ]
}
