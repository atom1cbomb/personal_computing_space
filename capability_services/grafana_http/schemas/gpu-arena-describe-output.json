{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "const": "ok"
    },
    "dashboard_uid": {
      "type": "string",
      "const": "gpu-arena"
    },
    "dashboard_version": {
      "type": "integer",
      "description": "Upstream dashboard revision number (identifier, no physical unit)."
    },
    "dashboard_url": {
      "type": "string",
      "description": "Grafana browser URL; its from/to query parameters are Unix milliseconds, while action start/end inputs are Unix seconds."
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "max_range_days": {
      "const": 90,
      "description": "Maximum selectable query window in days; one day is 86400 seconds."
    },
    "default_range": {
      "type": "object",
      "properties": {},
      "description": "Grafana relative time expressions, for example from=now-7d and to=now; d means days."
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {}
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Dashboard panel ID (identifier, not a count)."
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "field_config": {
            "type": "object",
            "properties": {},
            "description": "Native Grafana display configuration, including defaults.unit and overrides. Inspect it together with the target expression to interpret sample values."
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {}
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "field_config",
          "targets"
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "dashboard_uid",
    "dashboard_version",
    "dashboard_url",
    "title",
    "description",
    "max_range_days",
    "default_range",
    "variables",
    "panels",
    "notes"
  ]
}
