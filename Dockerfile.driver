FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends docker.io docker-cli ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY loom_v2 ./loom_v2
COPY loom_orchestration ./loom_orchestration
COPY migrations ./migrations
RUN pip install --no-cache-dir .
COPY docker/driver-entrypoint.sh /usr/local/bin/loom-driver-entrypoint
RUN chmod +x /usr/local/bin/loom-driver-entrypoint

ENV PYTHONUNBUFFERED=1
EXPOSE 8090

ENTRYPOINT ["/usr/local/bin/loom-driver-entrypoint"]
